{
    "nowo_short_link_redirect": {
        "path": "/s/{code}",
        "pathRegex": "{^/s/(?P<code>[^/]+)$}sDu",
        "host": "ANY",
        "hostRegex": "",
        "scheme": "ANY",
        "method": "GET|HEAD",
        "class": "Symfony\\Component\\Routing\\Route",
        "defaults": {
            "_controller": "Nowo\\ShortLinkBundle\\Infrastructure\\Http\\RedirectController",
            "_stateless": true
        },
        "requirements": {
            "code": "[^/]+"
        },
        "options": {
            "compiler_class": "Symfony\\Component\\Routing\\RouteCompiler",
            "utf8": true
        }
    },
    "nowo_short_link_index": {
        "path": "/short-links",
        "pathRegex": "{^/short\\-links$}sDu",
