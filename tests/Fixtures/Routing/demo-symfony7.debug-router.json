        "method": "GET",
        "class": "Symfony\\Component\\Routing\\Route",
        "defaults": {
            "_controller": "Nowo\\ShortLinkBundle\\Presentation\\Controller\\ShortLinkUiController::index"
        },
        "requirements": "NO CUSTOM",
        "options": {
            "compiler_class": "Symfony\\Component\\Routing\\RouteCompiler",
            "utf8": true
        }
    },
