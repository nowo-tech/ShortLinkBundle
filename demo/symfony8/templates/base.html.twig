{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN). The masthead lists the demo pages with the active item. -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}Short Link Bundle demo{% endblock %} — Symfony 8{% endblock %}

{% block nowo_ui_navigation %}
    {% set _route = app.request.attributes.get('_route') %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('demo_home') }}">Short Link Bundle · Symfony 8</a>
        <nav class="nowo-ui-menu" aria-label="Demo">
            {% for item in [{route: 'demo_home', label: 'Overview'}, {route: 'nowo_short_link_index', label: 'Short links'}] %}
                <a class="nowo-ui-link" href="{{ path(item.route) }}"{% if _route == item.route or (item.route != 'demo_home' and _route starts with 'nowo_short_link_') %} aria-current="page"{% endif %} data-testid="demo-nav-{{ item.route }}">{{ item.label }}</a>
            {% endfor %}
        </nav>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}
