{% extends 'base.html.twig' %}

{% block title %}Overview{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('nowo_short_link_index') }}" data-testid="demo-open-ui">Management pages</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Short Link Bundle',
        intro: 'Per-tenant short links with a public stateless redirect, a target guard, a privacy-preserving click log and a UiKit + FormKit management UI.',
        toolbar: _toolbar,
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Installation status', intro: 'Create short links in the management pages, open them through the redirect path and follow their clicks on the statistics page (daily chart, referrer sites, countries, browser families, CSV export).', kind: 'detail', testid: 'demo-status', redirect_prefix: redirect_prefix, ui_prefix: ui_prefix, ui_enabled: ui_enabled, database: database, worker: worker} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--info">S4</span>{% endblock %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <tbody>
                    <tr><th scope="row">Bundle</th><td><code class="nowo-ui-code">Nowo\ShortLinkBundle\NowoShortLinkBundle</code> registered</td></tr>
                    <tr><th scope="row">Redirect path</th><td><code class="nowo-ui-code">{{ redirect_prefix }}/{code}</code></td></tr>
                    <tr><th scope="row">Management UI</th><td><code class="nowo-ui-code">{{ ui_prefix }}</code> ({{ ui_enabled ? 'enabled' : 'disabled' }})</td></tr>
                    <tr><th scope="row">Database</th><td>{{ database is null ? 'not reachable' : 'MySQL ' ~ database }}</td></tr>
                    <tr><th scope="row">FrankenPHP</th><td>{{ worker ? 'worker mode (kernel kept alive, not reset)' : 'classic mode' }}</td></tr>
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}
{% endblock %}
