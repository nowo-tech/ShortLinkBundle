# -----------------------------------------------------------------------------
# Local environment (copy to .env — never commit .env, .env.local, or .env.dev)
# -----------------------------------------------------------------------------

# APP_ENV: Symfony environment (dev/test/prod). Demos use `dev` by default.
APP_ENV=dev

# APP_DEBUG: Verbose errors and Web Profiler (use `1` in dev).
APP_DEBUG=1

# FRANKENPHP_MODE: `worker` (default: kernel booted once, kept alive, not reset) or `classic` (one process per request).
FRANKENPHP_MODE=worker

# APP_SECRET: left empty on purpose; the container entrypoint writes a random value into .env on first start.
APP_SECRET=

# PORT: Host port published by docker-compose for this demo (must match your URL).
PORT=8230

###> doctrine/doctrine-bundle ###
# DATABASE_URL: MySQL service `db` on the private Compose network, passwordless root (demo only).
DATABASE_URL=mysql://root@db:3306/nowo_short_link_demo?serverVersion=8.0&charset=utf8mb4
###< doctrine/doctrine-bundle ###

###> symfony/routing ###
# DEFAULT_URI: Base URL for generating links in CLI; should match PORT above.
DEFAULT_URI=http://localhost:8230
###< symfony/routing ###
