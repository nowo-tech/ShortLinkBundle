{
    "name": "nowo-tech/short-link-demo-symfony7",
    "description": "Short Link Bundle demo (Symfony 7.4, FrankenPHP worker mode, MySQL, UiKit + FormKit)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2,<8.6",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^2.13 || ^3.0",
        "doctrine/orm": "^3.7",
        "nowo-tech/form-kit-bundle": "^2.22",
        "nowo-tech/short-link-bundle": "@dev",
        "nowo-tech/ui-kit-bundle": "^2.49",
        "symfony/asset": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "twig/extra-bundle": "^3.12",
        "twig/string-extra": "^3.12"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "post-install-cmd": [
            "@php bin/console cache:clear --no-warmup",
            "@php bin/console assets:install public"
        ],
        "post-update-cmd": [
            "@php bin/console cache:clear --no-warmup",
            "@php bin/console assets:install public"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "/var/short-link-bundle",
            "options": {
                "symlink": true
            }
        }
    ],
    "require-dev": {
        "nowo-tech/hot-reload-bundle": "^1.4",
        "nowo-tech/twig-inspector-bundle": "^1.0",
        "symfony/debug-bundle": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    }
}
